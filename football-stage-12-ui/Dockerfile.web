FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY command_service ./command_service
COPY scripts ./scripts
COPY tests ./tests
COPY requirements-dev.txt web_app.py ./
COPY templates ./templates
COPY static ./static
CMD ["python", "-m", "flask", "--app", "web_app:create_app", "run", "--host", "0.0.0.0", "--port", "5000"]
